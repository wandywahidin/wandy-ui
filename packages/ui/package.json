{
  "name": "@wandy29/ui",
  "version": "0.0.0",
  "description": "Accessible, customizable Vue 3.5 components styled with Tailwind CSS v4.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wandywahidin/wandy-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://wandywahidin.github.io/wandy-ui/",
  "bugs": {
    "url": "https://github.com/wandywahidin/wandy-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "design-system",
    "tailwindcss",
    "accessibility"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.stories.ts",
    "!src/test-utils.ts",
    "!src/vitest-axe.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --project unit",
    "test:dist": "vitest run --project dist",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src scripts"
  },
  "peerDependencies": {
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.2"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "10.6.7",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "jsdom": "31.0.1",
    "reka-ui": "2.11.0",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.1.1",
    "vitest-axe": "0.1.0",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  }
}
